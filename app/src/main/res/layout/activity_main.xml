<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D12"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ GFX Tool Pro"
            android:textColor="#F5A623"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v3.0 • Shizuku • HDR Unlocked"
            android:textColor="#555566"
            android:textSize="11sp"
            android:paddingBottom="8dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔴 Not connected"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Connect Shizuku"
            android:backgroundTint="#1E1E2E"
            android:textColor="#F5A623"
            android:layout_marginBottom="16dp" />

        <!-- ── Divider ─────────────────────────────────────────────────────── -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1A1A2E" android:layout_marginBottom="12dp"/>

        <!-- ── Game ───────────────────────────────────────────────────────── -->
        <TextView style="@style/SectionLabel" android:text="GAME" />
        <RadioGroup
            android:id="@+id/rgGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">
            <RadioButton android:id="@+id/rbBgmi" android:text="BGMI"
                android:checked="true" style="@style/RadioBtn" />
            <RadioButton android:id="@+id/rbPubg" android:text="PUBG Global"
                style="@style/RadioBtn" android:layout_marginStart="16dp" />
        </RadioGroup>

        <!-- ── FPS ────────────────────────────────────────────────────────── -->
        <TextView style="@style/SectionLabel" android:text="FPS CAP" />
        <RadioGroup
            android:id="@+id/rgFps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">
            <RadioButton android:id="@+id/rbFps30" android:text="30"  style="@style/RadioBtn"/>
            <RadioButton android:id="@+id/rbFps40" android:text="40"  style="@style/RadioBtn" android:layout_marginStart="8dp"/>
            <RadioButton android:id="@+id/rbFps60" android:text="60"  style="@style/RadioBtn" android:layout_marginStart="8dp" android:checked="true"/>
            <RadioButton android:id="@+id/rbFps90" android:text="90"  style="@style/RadioBtn" android:layout_marginStart="8dp"/>
            <RadioButton android:id="@+id/rbFps120" android:text="120" style="@style/RadioBtn" android:layout_marginStart="8dp"/>
        </RadioGroup>

        <!-- ── Graphics Quality ───────────────────────────────────────────── -->
        <TextView style="@style/SectionLabel" android:text="GRAPHICS QUALITY" />
        <RadioGroup
            android:id="@+id/rgGraphics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">
            <RadioButton android:id="@+id/rbSmooth"   android:text="Smooth"   style="@style/RadioBtn" android:checked="true"/>
            <RadioButton android:id="@+id/rbBalanced" android:text="Balanced" style="@style/RadioBtn" android:layout_marginStart="8dp"/>
            <RadioButton android:id="@+id/rbHD"       android:text="HD"       style="@style/RadioBtn" android:layout_marginStart="8dp"/>
            <RadioButton android:id="@+id/rbHDR"      android:text="HDR"      style="@style/RadioBtn" android:layout_marginStart="8dp"/>
        </RadioGroup>

        <!-- ── Style ──────────────────────────────────────────────────────── -->
        <TextView style="@style/SectionLabel" android:text="COLOUR STYLE" />
        <RadioGroup
            android:id="@+id/rgStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">
            <RadioButton android:id="@+id/rbClassic"   android:text="Classic"   style="@style/RadioBtn"/>
            <RadioButton android:id="@+id/rbRealistic" android:text="Realistic" style="@style/RadioBtn" android:layout_marginStart="8dp"/>
            <RadioButton android:id="@+id/rbColorful"  android:text="Colorful"  style="@style/RadioBtn" android:layout_marginStart="8dp" android:checked="true"/>
            <RadioButton android:id="@+id/rbSoft"      android:text="Soft"      style="@style/RadioBtn" android:layout_marginStart="8dp"/>
        </RadioGroup>

        <!-- ── Resolution ─────────────────────────────────────────────────── -->
        <TextView style="@style/SectionLabel" android:text="RENDER RESOLUTION" />
        <RadioGroup
            android:id="@+id/rgRes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">
            <RadioButton android:id="@+id/rbRes540"  android:text="540p" style="@style/RadioBtn"/>
            <RadioButton android:id="@+id/rbRes720"  android:text="720p" style="@style/RadioBtn" android:layout_marginStart="8dp" android:checked="true"/>
            <RadioButton android:id="@+id/rbRes1080" android:text="1080p" style="@style/RadioBtn" android:layout_marginStart="8dp"/>
        </RadioGroup>

        <!-- ── Shadow ─────────────────────────────────────────────────────── -->
        <TextView style="@style/SectionLabel" android:text="SHADOW" />
        <RadioGroup
            android:id="@+id/rgShadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">
            <RadioButton android:id="@+id/rbShadowOff"  android:text="Off"  style="@style/RadioBtn" android:checked="true"/>
            <RadioButton android:id="@+id/rbShadowLow"  android:text="Low"  style="@style/RadioBtn" android:layout_marginStart="8dp"/>
            <RadioButton android:id="@+id/rbShadowMed"  android:text="Med"  style="@style/RadioBtn" android:layout_marginStart="8dp"/>
            <RadioButton android:id="@+id/rbShadowHigh" android:text="High" style="@style/RadioBtn" android:layout_marginStart="8dp"/>
        </RadioGroup>

        <!-- ── Divider ─────────────────────────────────────────────────────── -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1A1A2E" android:layout_marginBottom="12dp"/>

        <!-- ── Toggle Switches ────────────────────────────────────────────── -->
        <TextView style="@style/SectionLabel" android:text="FEATURES" />

        <Switch
            android:id="@+id/swHdr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌈 HDR Unlock  (writes Engine.ini + r.AllowHDR)"
            android:textColor="#F5A623"
            android:textSize="13sp"
            android:paddingBottom="8dp"
            android:thumbTint="#F5A623"
            android:trackTint="#3A2800" />

        <Switch
            android:id="@+id/swVulkan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔺 Vulkan Rendering  (better GPU on Dimensity)"
            android:textColor="#DDD"
            android:textSize="13sp"
            android:paddingBottom="8dp"
            android:thumbTint="#F5A623"
            android:trackTint="#222233" />

        <Switch
            android:id="@+id/swIpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 iPad View  (wider FOV)"
            android:textColor="#DDD"
            android:textSize="13sp"
            android:paddingBottom="8dp"
            android:thumbTint="#F5A623"
            android:trackTint="#222233" />

        <Switch
            android:id="@+id/swMsaa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Anti-Aliasing (MSAA 4x)"
            android:textColor="#DDD"
            android:textSize="13sp"
            android:paddingBottom="16dp"
            android:thumbTint="#F5A623"
            android:trackTint="#222233" />

        <!-- ── Divider ─────────────────────────────────────────────────────── -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1A1A2E" android:layout_marginBottom="12dp"/>

        <!-- ── Quick Presets ──────────────────────────────────────────────── -->
        <TextView style="@style/SectionLabel" android:text="QUICK PRESETS" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnPresetCompetitive"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🏆 Competitive"
                android:backgroundTint="#1E2E1E"
                android:textColor="#4CAF50"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPresetHdr"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🌈 HDR Colorful"
                android:backgroundTint="#2E1E2E"
                android:textColor="#E040FB"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPresetBalanced"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="⚖️ Balanced"
                android:backgroundTint="#1E1E2E"
                android:textColor="#F5A623"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnPresetBattery"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🔋 Battery"
                android:backgroundTint="#2E2010"
                android:textColor="#FF9800"
                android:textSize="11sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- ── Divider ─────────────────────────────────────────────────────── -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1A1A2E" android:layout_marginTop="8dp" android:layout_marginBottom="12dp"/>

        <!-- ── Apply ──────────────────────────────────────────────────────── -->
        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⚡ APPLY ALL SETTINGS"
            android:backgroundTint="#F5A623"
            android:textColor="#000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <!-- Boost -->
        <Button
            android:id="@+id/btnBoost"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🚀 BOOST  (Kill Background + Clear Cache)"
            android:backgroundTint="#4CAF50"
            android:textColor="#000"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Debug log -->
        <Button
            android:id="@+id/btnLog"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="📋 Show Debug Log"
            android:backgroundTint="#1A1A28"
            android:textColor="#555566"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="v3.0 • Shizuku • HDR • Poco M7 Pro Optimised"
            android:textColor="#333344"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingBottom="8dp"/>

    </LinearLayout>
</ScrollView>
